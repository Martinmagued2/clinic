# =====================================================================
# Clinic Command Center — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ---- Database ----
# LOCAL DEV (SQLite):
DATABASE_URL="file:./db/custom.db"

# PRODUCTION (Supabase PostgreSQL):
# 1. Go to https://supabase.com → create a new project
# 2. Settings → Database → Connection string → URI
# 3. Paste it here (replace with your actual connection string):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# For serverless (Vercel), use the connection POOLER URL:
# DATABASE_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ---- Authentication ----
# Secret used to sign session cookies. Generate a long random string.
# Example: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# ---- Application ----
NODE_ENV="development"
PORT=3000

# ---- Vercel (auto-set by Vercel) ----
# VERCEL=1  (automatically set when deployed on Vercel)
# VERCEL_URL=your-app.vercel.app  (automatically set)

# ---- Supabase Storage (for patient documents in production) ----
# Required for production file storage on Vercel.
# Get these from: Supabase Dashboard → Settings → API
# SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# SUPABASE_SERVICE_KEY="[YOUR-SERVICE-ROLE-KEY]"  # NOT the anon key!
#
# If not set, files are stored in the database (base64) as a fallback.

# ---- File Storage ----
# On Vercel: files are stored in Supabase Storage (if configured) or database
# On local dev: files are stored in /uploads directory
# For production with large files, use Supabase Storage (see above)

# ---- External Notifications (future — see spec #36, #37) ----
# EMAIL_PROVIDER_KEY=""
# WHATSAPP_API_KEY=""

# ---- Rate Limiting ----
# Local dev: in-memory rate limiting (default)
# Vercel: automatically uses database-backed rate limiting (no config needed)
# To force DB rate limiting on self-hosted: USE_DB_RATE_LIMIT=1

# ---- Security Notes ----
# NEVER use NEXT_PUBLIC_ prefix for secrets (DATABASE_URL, SESSION_SECRET, etc.)
# NEXT_PUBLIC_ variables are exposed to the browser
