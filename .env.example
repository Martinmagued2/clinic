# =====================================================================
# Clinic Command Center — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ---- Database ----
# SQLite (development). Use a relative file path under /db.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# PostgreSQL (production). Uncomment and replace with your connection string.
# DATABASE_URL="postgresql://user:password@localhost:5432/clinic?schema=public"

# ---- Authentication ----
# Secret used to sign session cookies. Generate a long random string.
# Example: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# ---- Application ----
NODE_ENV="development"
PORT=3000

# ---- File Storage (future — see spec #33) ----
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_BUCKET=""

# ---- External Notifications (future — see spec #36, #37) ----
# EMAIL_PROVIDER_KEY=""
# WHATSAPP_API_KEY=""

# ---- Rate Limiting / Brute Force Protection (spec #6) ----
# Configure at the deployment layer (e.g. Caddy, Nginx, Cloudflare).
