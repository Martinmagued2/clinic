# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit real secrets — .env.example is tracked explicitly)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
dev.log
server.log

# local dev artifacts
.claude
.z-ai-config
local-*

# Editor / OS
.idea/
.vscode/
*.swp
Thumbs.db

# Skills directory (internal)
/skills/

# Uploads / tooling (internal)
/upload/
/tool-results/

# Local DB (SQLite dev)
/db/*.db
/db/*.db-journal

# Z scripts (internal sandbox tooling)
/.zscripts/
dev.log
